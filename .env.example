# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/safehire_auth
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/safehire_auth

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=SafeHire Auth Service
DEBUG=true
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server
HOST=0.0.0.0
PORT=8001

# Observability Stack (floci | vps | aws)
OBSERVABILITY_STACK=floci
FLOCI_ENDPOINT=http://localhost:4566

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
XRAY_DAEMON_ADDRESS=localhost:2000

# VPS Observability
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

# CloudWatch
CLOUDWATCH_LOG_GROUP=/safehire/auth-service

# Tracing
TRACE_SAMPLING_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
